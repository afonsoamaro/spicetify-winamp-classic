{
  "name": "spicetify-winamp-classic",
  "version": "0.1.0",
  "private": true,
  "description": "The classic Winamp 2.x look for Spotify, as a Spicetify theme",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.js",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "embed:font": "node scripts/embed-font.js",
    "embed:scheme": "node scripts/embed-scheme.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
